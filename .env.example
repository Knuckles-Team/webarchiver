# Optional SDK settings, loaded by the operator; no credentials are stored here.
HOST=127.0.0.1
PORT=8000
TRANSPORT=stdio
AUTH_TYPE=none
SYSTEMTOOL=True
# Fetch policy. The connector reads the public web and needs no credentials.
WEBARCHIVER_USER_AGENT=webarchiver/1.0 (+https://github.com/Knuckles-Team/webarchiver)
WEBARCHIVER_MAX_BYTES=5242880
WEBARCHIVER_MIN_INTERVAL_S=1.0
WEBARCHIVER_TIMEOUT_S=20
WEBARCHIVER_OBEY_ROBOTS=true
# Loopback and private destinations are refused unless explicitly allowed.
WEBARCHIVER_ALLOW_LOOPBACK=false
WEBARCHIVER_ALLOWED_PRIVATE_HOSTS=
